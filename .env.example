# Set these in Railway -> your service -> Variables (never commit real secrets).
# Choose a long random value (>= 24 characters) to protect privileged signup:
PAKESY_OWNER_SETUP_CODE=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Optional: stable signed-session secret; otherwise stored on persistent volume.
PAKESY_SESSION_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
# Railway adds RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
# Alternative hosting: set PAKESY_STORAGE_ROOT=/absolute/persistent/path
